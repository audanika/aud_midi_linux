{
  "name": "aud_midi_linux",
  "summary": "The Linux backend of aud_midi in pure Dart: ALSA sequencer (MIDI 1.0 and UMP) through FFI, BLE-MIDI over BlueZ and DNS-SD advertising over Avahi, both on D-Bus.",
  "domain": [
    "Linux MIDI backend",
    "ALSA sequencer via dart:ffi (ffigen bindings, reader isolate, queues, UMP)",
    "BlueZ BLE-MIDI central, Avahi DNS-SD"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "MidiBackend, MidiBackendHost, MidiBleTransport, MidiBleBluetoothBackend, MidiServiceAdvertiser, MidiClockMapper, MidiException",
      "aud_midi_standard": "port models, MidiPacket, MidiBytes, Ump, MidiStatus",
      "bluez": "BlueZ adapter discovery, device connect",
      "dbus": "GATT characteristic notify/write, Avahi EntryGroup",
      "ffi": "libasound.so.2 (alsa-lib), clock_gettime"
    },
    "usedBy": {
      "aud_midi": "LinuxMidiBackend; MidiAvahiServiceAdvertiser for the AppleMIDI session"
    }
  }
}
