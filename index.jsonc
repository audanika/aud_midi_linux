{
  "name": "aud_midi_linux",
  "summary": "The Linux backend of aud_midi in pure Dart: ALSA sequencer (MIDI 1.0 and UMP) through FFI, BLE over BlueZ and Avahi over D-Bus.",
  "domain": [
    "Linux MIDI backend"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "backend contracts",
      "aud_midi_standard": "models"
    },
    "usedBy": {
      "aud_midi": "consumes this package"
    }
  }
}
